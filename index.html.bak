<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portofolio Renataa | Siswa SMK Telkom Malang</title>
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            pinkbrand: {
              50: '#FFF5F8',
              100: '#FFEBF2',
              200: '#FFD6E4',
              300: '#FFB8CF',
              400: '#FF8EB5',
              500: '#FF6B9D', // Warna Pink Tunggal: Soft tapi tetap Cerah
              600: '#F05589',
              700: '#D4386E',
            }
          },
          animation: {
            'bounce-slow': 'bounce 3s infinite',
            'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
          }
        }
      }
    }
  </script>

  <style>
    /* Latar belakang glow halus dengan rona pink seragam */
    .bg-vibrant-glow {
      background: radial-gradient(circle at 14% 18%, rgba(255, 107, 157, 0.12), transparent 44%),
                  radial-gradient(circle at 86% 24%, rgba(255, 107, 157, 0.12), transparent 46%),
                  radial-gradient(circle at 50% 82%, rgba(255, 107, 157, 0.10), transparent 48%);
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 214, 228, 0.85);
    }
    
    .dark .glass-card {
      background: rgba(24, 12, 19, 0.85);
      border: 1px solid rgba(255, 107, 157, 0.25);
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #FFF5F8;
    }
    ::-webkit-scrollbar-thumb {
      background: #FFD6E4;
      border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FF6B9D;
    }
  </style>
</head>
<body class="bg-[#FFF9FB] text-slate-800 antialiased font-sans selection:bg-[#FF6B9D] selection:text-white transition-colors duration-300">

  <!-- Glow Background Effect -->
  <div class="fixed inset-0 bg-vibrant-glow pointer-events-none -z-10"></div>

  <!-- NAVBAR -->
  <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="#hero" class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 rounded-xl overflow-hidden p-0.5 bg-[#FF6B9D] shadow-md shadow-pink-300/30 group-hover:scale-110 transition-transform">
            <img src="profile.jpg" alt="Renataa" class="w-full h-full rounded-[10px] object-cover object-[center_30%]">
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-lg tracking-tight text-[#FF6B9D]">
              renataa.tkj
            </span>
            <span class="text-[11px] font-semibold text-slate-500 tracking-wider uppercase -mt-1">SMK Telkom Malang</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 bg-white/90 backdrop-blur-md px-4 py-2 rounded-full border border-[#FFD6E4] shadow-sm">
          <a href="#tentang" class="px-4 py-1.5 text-sm font-semibold text-slate-600 hover:text-[#FF6B9D] hover:bg-[#FFF0F5] rounded-full transition-all">Tentang</a>
          <a href="#keahlian" class="px-4 py-1.5 text-sm font-semibold text-slate-600 hover:text-[#FF6B9D] hover:bg-[#FFF0F5] rounded-full transition-all">Keahlian</a>
          <a href="#projek" class="px-4 py-1.5 text-sm font-semibold text-slate-600 hover:text-[#FF6B9D] hover:bg-[#FFF0F5] rounded-full transition-all">Projek Praktik</a>
          <a href="#terminal" class="px-4 py-1.5 text-sm font-semibold text-slate-600 hover:text-[#FF6B9D] hover:bg-[#FFF0F5] rounded-full transition-all">TKJ Lab</a>
          <a href="#kontak" class="px-4 py-1.5 text-sm font-semibold text-slate-600 hover:text-[#FF6B9D] hover:bg-[#FFF0F5] rounded-full transition-all">Kontak</a>
        </nav>

        <!-- CTA & Mobile Menu Toggle -->
        <div class="flex items-center gap-3">
          <a href="https://instagram.com/r4en.ata" target="_blank" class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-bold text-sm text-white bg-[#FF6B9D] hover:bg-[#F05589] shadow-md shadow-pink-300/30 hover:-translate-y-0.5 transition-all">
            <i data-lucide="instagram" class="w-4 h-4"></i>
            <span>DM Instagram</span>
          </a>

          <!-- Mobile Hamburger -->
          <button id="menu-btn" aria-label="Toggle Menu" class="md:hidden p-2 rounded-xl bg-white border border-[#FFD6E4] text-slate-700 hover:bg-[#FFF0F5] transition-colors">
            <i data-lucide="menu" id="menu-icon" class="w-6 h-6 text-[#FF6B9D]"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-b border-[#FFD6E4] px-6 py-6 shadow-xl space-y-3">
      <a href="#tentang" class="mobile-nav-link block font-semibold text-slate-700 py-2 border-b border-pink-50">Tentang Saya</a>
      <a href="#keahlian" class="mobile-nav-link block font-semibold text-slate-700 py-2 border-b border-pink-50">Keahlian & Tools</a>
      <a href="#projek" class="mobile-nav-link block font-semibold text-slate-700 py-2 border-b border-pink-50">Projek Praktik</a>
      <a href="#terminal" class="mobile-nav-link block font-semibold text-slate-700 py-2 border-b border-pink-50">TKJ Lab Simulator</a>
      <a href="#kontak" class="mobile-nav-link block font-semibold text-slate-700 py-2">Kontak</a>
      <a href="https://instagram.com/r4en.ata" target="_blank" class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-sm text-white bg-[#FF6B9D] hover:bg-[#F05589] mt-4 shadow-md shadow-pink-300/30">
        <i data-lucide="instagram" class="w-4 h-4"></i>
        <span>DM Instagram</span>
      </a>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section id="hero" class="pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Copywriting -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FFF0F5] border border-[#FFD6E4] text-[#FF6B9D] font-bold text-xs sm:text-sm shadow-sm animate-pulse-slow">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B9D] animate-ping"></span>
            <span>⚡ Siswa SMK Telkom Malang (TKJ) • Siap Belajar & Eksplorasi</span>
          </div>

          <!-- Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-tight">
            Halo! Saya <span class="text-[#FF6B9D]">Renataa</span>, Pecinta Jaringan Komputer.
          </h1>

          <!-- Subheadline -->
          <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
            Siswa kelas 10 jurusan <strong>Teknik Komputer dan Jaringan (TKJ)</strong> di <strong>SMK Telkom Malang</strong> yang antusias mempelajari konfigurasi router, perakitan PC, server Linux, serta dunia digital yang serba terhubung.
          </p>

          <!-- Buttons & Stats -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
            <a href="#projek" class="px-6 py-3.5 rounded-2xl font-bold text-white bg-[#FF6B9D] hover:bg-[#F05589] shadow-lg shadow-pink-300/30 hover:-translate-y-1 transition-all flex items-center gap-2">
              <i data-lucide="layers" class="w-5 h-5"></i>
              <span>Lihat Projek Saya</span>
            </a>
            <a href="#terminal" class="px-6 py-3.5 rounded-2xl font-bold text-slate-700 bg-white border border-[#FFD6E4] hover:border-[#FF6B9D] hover:text-[#FF6B9D] shadow-sm hover:-translate-y-1 transition-all flex items-center gap-2">
              <i data-lucide="terminal" class="w-5 h-5 text-[#FF6B9D]"></i>
              <span>Coba Terminal Lab</span>
            </a>
          </div>

          <!-- Quick Highlights -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-6 border-t border-[#FFD6E4]/60 max-w-lg mx-auto lg:mx-0 text-center sm:text-left">
            <div class="p-2.5 rounded-xl bg-[#FFF0F5] border border-[#FFD6E4]">
              <p class="text-sm sm:text-base font-black text-[#FF6B9D]">Perkabelan</p>
              <p class="text-[11px] font-semibold text-slate-500">Kabel LAN UTP</p>
            </div>
            <div class="p-2.5 rounded-xl bg-[#FFF0F5] border border-[#FFD6E4]">
              <p class="text-sm sm:text-base font-black text-[#FF6B9D]">Switch</p>
              <p class="text-[11px] font-semibold text-slate-500">VLAN & Trunk</p>
            </div>
            <div class="p-2.5 rounded-xl bg-[#FFF0F5] border border-[#FFD6E4]">
              <p class="text-sm sm:text-base font-black text-[#FF6B9D]">Router</p>
              <p class="text-[11px] font-semibold text-slate-500">Static Routing</p>
            </div>
            <div class="p-2.5 rounded-xl bg-[#FFF0F5] border border-[#FFD6E4]">
              <p class="text-sm sm:text-base font-black text-[#FF6B9D]">MikroTik</p>
              <p class="text-[11px] font-semibold text-slate-500">Winbox Setup</p>
            </div>
          </div>

        </div>

        <!-- Right Column: Vibrant Visual Card -->
        <div class="lg:col-span-5 relative">
          <!-- Floating Shapes / Blobs -->
          <div class="absolute -top-10 -right-10 w-72 h-72 bg-[#FF6B9D] rounded-full blur-3xl opacity-20 -z-10"></div>
          <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#FF6B9D] rounded-full blur-3xl opacity-20 -z-10"></div>

          <!-- Main Interactive Profile Card -->
          <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border-2 border-white/90">
            
            <!-- Top badge status -->
            <div class="flex items-center justify-between pb-6 border-b border-[#FFD6E4]/80">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-slate-300"></span>
                <span class="w-3 h-3 rounded-full bg-[#FFD6E4]"></span>
                <span class="w-3 h-3 rounded-full bg-[#FF6B9D]"></span>
              </div>
              <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-[#FFF0F5] text-[#FF6B9D] border border-[#FFD6E4]">eth0 : CONNECTED</span>
            </div>

            <!-- Avatar & Greeting -->
            <div class="pt-6 text-center">
              <div class="relative inline-block">
                <div class="w-36 h-36 mx-auto rounded-3xl bg-[#FF6B9D] p-1 shadow-xl shadow-pink-300/30">
                  <div class="w-full h-full bg-slate-900 rounded-[22px] overflow-hidden">
                    <img src="profile.jpg" alt="Foto Profil Renataa" class="w-full h-full object-cover object-[center_30%] hover:scale-105 transition-transform duration-300">
                  </div>
                </div>
                <span class="absolute bottom-1 right-1 bg-[#FF6B9D] text-white p-1.5 rounded-xl border-2 border-white shadow-md font-bold">
                  <i data-lucide="wifi" class="w-4 h-4"></i>
                </span>
              </div>

              <h3 class="mt-4 font-extrabold text-xl text-slate-800">Renataa</h3>
              <p class="text-sm font-semibold text-[#FF6B9D]">SMK Telkom Malang • Jurusan TKJ</p>
            </div>

            <!-- Mini Spec Card List -->
            <div class="mt-6 space-y-2.5">
              <div class="flex items-center justify-between p-3 rounded-2xl bg-white/90 border border-[#FFD6E4] shadow-sm text-xs sm:text-sm">
                <div class="flex items-center gap-2.5 text-slate-600">
                  <i data-lucide="cable" class="w-4 h-4 text-[#FF6B9D]"></i>
                  <span class="font-medium">Perkabelan LAN</span>
                </div>
                <span class="font-bold text-slate-800">Straight & Cross T568A/B</span>
              </div>
              <div class="flex items-center justify-between p-3 rounded-2xl bg-white/90 border border-[#FFD6E4] shadow-sm text-xs sm:text-sm">
                <div class="flex items-center gap-2.5 text-slate-600">
                  <i data-lucide="network" class="w-4 h-4 text-[#FF6B9D]"></i>
                  <span class="font-medium">Switch & Router</span>
                </div>
                <span class="font-bold text-slate-800">VLAN & Routing Cisco</span>
              </div>
              <div class="flex items-center justify-between p-3 rounded-2xl bg-white/90 border border-[#FFD6E4] shadow-sm text-xs sm:text-sm">
                <div class="flex items-center gap-2.5 text-slate-600">
                  <i data-lucide="router" class="w-4 h-4 text-[#FF6B9D]"></i>
                  <span class="font-medium">Konfigurasi MikroTik</span>
                </div>
                <span class="font-bold text-slate-800">Winbox & RouterOS</span>
              </div>
            </div>

            <!-- Bottom Motivational Quote -->
            <div class="mt-6 p-3 rounded-2xl bg-[#FFF0F5] border border-[#FFD6E4] text-center">
              <p class="text-xs font-semibold text-[#D4386E] italic">"Tidak ada koneksi yang terputus selama kita tahu cara routing-nya!"</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TENTANG SAYA SECTION -->
  <section id="tentang" class="py-20 bg-white border-y border-slate-200/60 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FF6B9D] bg-[#FFF0F5] px-3.5 py-1.5 rounded-full border border-[#FFD6E4]">
          Tentang Diri Saya
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 tracking-tight">
          Menyukai Tantangan Komputer & Dunia Kabel
        </h2>
        <p class="text-slate-600 mt-3 text-base">
          Mulai dari penasaran bagaimana internet bekerja di rumah, hingga sekarang mendalami routing, subnetting, dan sistem operasi open-source di SMK.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1 -->
        <div class="p-8 rounded-3xl bg-white border border-[#FFD6E4] hover:border-[#FF6B9D] hover:shadow-xl hover:shadow-pink-300/20 hover:-translate-y-1.5 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-2xl bg-[#FF6B9D] text-white flex items-center justify-center mb-6 shadow-md shadow-pink-300/30 group-hover:scale-110 transition-transform">
            <i data-lucide="graduation-cap" class="w-7 h-7"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2">Pendidikan Aktif</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Saat ini sedang menempuh kelas 10 di <strong>SMK Telkom Malang</strong> pada jurusan <strong>Teknik Komputer dan Jaringan (TKJ)</strong>. Selalu antusias dalam praktikum bengkel lab dan proyek kolaborasi.
          </p>
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#FF6B9D] bg-[#FFF0F5] px-3 py-1 rounded-full border border-[#FFD6E4]">
            <span>Fokus: Dasar Jaringan & Sistem Operasi</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-8 rounded-3xl bg-white border border-[#FFD6E4] hover:border-[#FF6B9D] hover:shadow-xl hover:shadow-pink-300/20 hover:-translate-y-1.5 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-2xl bg-[#FF6B9D] text-white flex items-center justify-center mb-6 shadow-md shadow-pink-300/30 group-hover:scale-110 transition-transform">
            <i data-lucide="heart" class="w-7 h-7"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2">Minat & Passion</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Sangat tertarik dengan topologi jaringan, konfigurasi perangkat MikroTik, manajemen bandwidth, command line Linux, serta coding web dasar untuk membuat tampilan antarmuka modern.
          </p>
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#FF6B9D] bg-[#FFF0F5] px-3 py-1 rounded-full border border-[#FFD6E4]">
            <span>Networking • Linux • Web</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-8 rounded-3xl bg-white border border-[#FFD6E4] hover:border-[#FF6B9D] hover:shadow-xl hover:shadow-pink-300/20 hover:-translate-y-1.5 transition-all duration-300 group">
          <div class="w-14 h-14 rounded-2xl bg-[#FF6B9D] text-white flex items-center justify-center mb-6 shadow-md shadow-pink-300/30 group-hover:scale-110 transition-transform">
            <i data-lucide="target" class="w-7 h-7"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-2">Tujuan & Visi</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Bercita-cita menjadi seorang <strong>Network Engineer / DevOps Engineer</strong> yang kompeten. Siap mencari pengalaman magang/PKL dan proyek nyata untuk mengasah kemampuan teknis.
          </p>
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#FF6B9D] bg-[#FFF0F5] px-3 py-1 rounded-full border border-[#FFD6E4]">
            <span>Goal: Sertifikasi MTCNA / CCNA</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- KEAHLIAN / SKILLS SECTION -->
  <section id="keahlian" class="py-20 bg-[#FFF9FB]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FF6B9D] bg-[#FFF0F5] px-3.5 py-1.5 rounded-full border border-[#FFD6E4]">
          Keahlian & Kemampuan
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-4 tracking-tight">
          Apa Saja yang Sudah Saya Pelajari?
        </h2>
        <p class="text-slate-600 mt-3 text-base">
          Kombinasi materi pembelajaran teori kelas 10 SMK TKJ, praktikum mandiri, dan eksplorasi teknologi secara otodidak.
        </p>
      </div>

      <!-- Skills Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Skill Category 1 -->
        <div class="bg-white rounded-3xl p-6 border border-[#FFD6E4] shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F5] text-[#FF6B9D] flex items-center justify-center mb-5 font-bold border border-[#FFD6E4]">
            <i data-lucide="network" class="w-6 h-6"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2">Jaringan Dasar</h3>
          <p class="text-xs text-slate-500 mb-4">Topologi, pengkabelan, dan pengalamatan IP.</p>
          
          <ul class="space-y-2 text-xs font-semibold text-slate-700">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              Crimping RJ45 (Straight & Cross)
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              IPv4 & Subnetting (CIDR /24 - /30)
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              LAN & WLAN Setup
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              Testing LAN Tester & Ping
            </li>
          </ul>
        </div>

        <!-- Skill Category 2 -->
        <div class="bg-white rounded-3xl p-6 border border-[#FFD6E4] shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F5] text-[#FF6B9D] flex items-center justify-center mb-5 font-bold border border-[#FFD6E4]">
            <i data-lucide="router" class="w-6 h-6"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2">Router & Simulasi</h3>
          <p class="text-xs text-slate-500 mb-4">Konfigurasi perangkat dan topologi virtual.</p>
          
          <ul class="space-y-2 text-xs font-semibold text-slate-700">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              Cisco Packet Tracer Simulation
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              Dasar RouterOS (MikroTik Winbox)
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              DHCP Server & Client
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D]"></span>
              Static Routing Dasar
            </li>
          </ul>
        </div>

        <!-- Skill Category 3 -->
