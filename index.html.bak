  <!-- INTERACTIVE SECTION: TKJ LAB SIMULATOR (Subnet & Ping Terminal) -->
  <section id="terminal" class="py-20 bg-slate-950 text-slate-100 relative overflow-hidden">
    <!-- Glow effect -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#FF6B9D]/15 blur-[130px] pointer-events-none rounded-full"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FF6B9D] bg-[#2E0B22] px-3.5 py-1.5 rounded-full border border-[#FF6B9D]/30">
          Fitur Interaktif
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          ⚡ Mini Terminal Lab TKJ
        </h2>
        <p class="text-[#FFD6E4]/80 mt-2 text-sm max-w-xl mx-auto">
          Coba simulasi interaktif perintah dasar jaringan! Ketik perintah atau klik tombol cepat di bawah terminal.
        </p>
      </div>

      <!-- Terminal Window -->
      <div class="rounded-3xl bg-[#170B14]/95 border border-[#FF6B9D]/25 shadow-2xl shadow-pink-950/40 overflow-hidden backdrop-blur font-mono text-sm">
        
        <!-- Window Bar -->
        <div class="px-5 py-4 bg-[#120810]/90 border-b border-[#FF6B9D]/20 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-slate-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFD6E4] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#FF6B9D] inline-block"></span>
            <span class="ml-2 text-xs text-[#FFD6E4]/70 font-sans font-medium">renataa@tkj-lab:~$</span>
          </div>
          <span class="text-[11px] text-[#FFD6E4]/40">bash / zsh v5.9</span>
        </div>

        <!-- Terminal Output -->
        <div id="terminal-screen" class="p-6 h-64 overflow-y-auto space-y-2 text-xs sm:text-sm leading-relaxed text-slate-200">
          <p class="text-[#FF6B9D] font-bold">Selamat datang di Simulasi Terminal Portofolio Renataa (SMK TKJ)!</p>
          <p class="text-[#FFD6E4]/80">Ketik <span class="text-[#FF6B9D] font-bold">'help'</span> untuk melihat daftar perintah, atau gunakan tombol di bawah.</p>
          <div class="border-b border-[#FF6B9D]/20 my-2"></div>
        </div>

        <!-- Terminal Input Line -->
        <div class="px-5 py-3 bg-[#120810]/70 border-t border-[#FF6B9D]/20 flex items-center gap-2">
          <span class="text-[#FF6B9D] font-bold font-mono">➜</span>
          <span class="text-[#FFB8CF] font-bold font-mono">~</span>
          <input 
            type="text" 
            id="term-input" 
            placeholder="Ketik command: 'ping', 'whoami', 'subnet', 'clear'..."
            class="flex-1 bg-transparent border-none text-[#FFF0F5] placeholder-[#FFD6E4]/40 focus:outline-none font-mono text-xs sm:text-sm"
            autocomplete="off"
          />
          <button id="term-submit" class="px-4 py-1.5 rounded-lg bg-[#FF6B9D] hover:bg-[#F05589] text-white font-sans text-xs font-bold transition-colors shadow-md shadow-pink-300/30">
            Kirim
          </button>
        </div>

      </div>

      <!-- Quick Command Pills -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="text-[#FFD6E4]/70 font-semibold mr-1">Tombol Cepat:</span>
        <button onclick="runCommand('whoami')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">whoami</button>
        <button onclick="runCommand('skills')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">skills</button>
        <button onclick="runCommand('ping google.com')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">ping google.com</button>
        <button onclick="runCommand('ip a')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">ip a</button>
        <button onclick="runCommand('subnet')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">subnet</button>
        <button onclick="runCommand('clear')" class="px-3 py-1.5 rounded-xl bg-[#240A1D] hover:bg-[#FF6B9D] hover:text-white text-[#FFD6E4] font-mono transition-colors border border-[#FF6B9D]/30">clear</button>
      </div>

    </div>
  </section>

  <!-- KONTAK SECTION -->
  <section id="kontak" class="py-20 bg-[#FFF9FB] relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-2xl relative overflow-hidden border-2 border-[#FFD6E4]/30">
        
        <!-- Abstract Circles -->
        <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-[#FF6B9D]/15 blur-2xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-64 h-64 rounded-full bg-[#FF6B9D]/15 blur-2xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
          
          <!-- Left Info -->
          <div class="lg:col-span-7 space-y-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-white text-xs font-bold uppercase tracking-wider backdrop-blur-sm border border-[#FFD6E4]/30">
              <i data-lucide="message-circle" class="w-3.5 h-3.5 text-[#FF6B9D]"></i> Hubungi Saya
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold leading-tight">
              Tertarik Terhubung atau Berkolaborasi?
            </h2>
            <p class="text-[#FFD6E4]/90 text-sm sm:text-base leading-relaxed">
              Saya selalu bersemangat untuk belajar hal baru, mengikuti proyek jaringan/teknologi, atau bertukar wawasan seputar dunia IT. Jangan ragu menyapa saya melalui Instagram!
            </p>

            <div class="pt-4 flex flex-col sm:flex-row gap-3">
              <!-- Instagram Direct Message Button -->
              <a href="https://instagram.com/r4en.ata" target="_blank" class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl bg-[#FF6B9D] hover:bg-[#F05589] text-white font-extrabold text-sm shadow-lg shadow-pink-300/30 hover:-translate-y-0.5 transition-all">
                <i data-lucide="instagram" class="w-5 h-5"></i>
                <span>Kirim DM Instagram @r4en.ata</span>
              </a>
            </div>
          </div>

          <!-- Right Quick Form / Info Box -->
          <div class="lg:col-span-5 bg-white/5 backdrop-blur-xl p-6 rounded-2xl border border-[#FFD6E4]/20 space-y-4 text-xs sm:text-sm">
            <h4 class="font-bold text-white text-base flex items-center gap-2">
              <i data-lucide="user-check" class="w-4 h-4 text-[#FF6B9D]"></i> Informasi Profil
            </h4>
            
            <div class="space-y-3 text-[#FFD6E4]">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-[#FF6B9D]/20 flex items-center justify-center text-[#FF6B9D]">
                  <i data-lucide="school" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-[11px] text-[#FFD6E4]/70">Sekolah</p>
                  <p class="font-semibold text-white">SMK Telkom Malang</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-[#FF6B9D]/20 flex items-center justify-center text-[#FF6B9D]">
                  <i data-lucide="cpu" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-[11px] text-[#FFD6E4]/70">Jurusan</p>
                  <p class="font-semibold text-white">Teknik Komputer & Jaringan (TKJ)</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-[#FF6B9D]/20 flex items-center justify-center text-[#FF6B9D]">
                  <i data-lucide="instagram" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-[11px] text-[#FFD6E4]/70">Akun Instagram</p>
                  <a href="https://instagram.com/r4en.ata" target="_blank" class="font-semibold text-white hover:text-[#FF6B9D] transition-colors flex items-center gap-1.5 underline decoration-[#FFD6E4]/50 hover:decoration-[#FF6B9D]">
                    @r4en.ata
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                  </a>
                </div>
              </div>
            </div>

            <p class="text-[11px] text-[#FFD6E4]/70 pt-2 border-t border-[#FF6B9D]/20 italic">
              *Silakan hubungi melalui DM Instagram untuk berdiskusi atau peluang proyek lab.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="py-8 bg-slate-900 text-slate-400 text-xs border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-[#FF6B9D] flex items-center justify-center text-white">
          <i data-lucide="network" class="w-3.5 h-3.5"></i>
        </div>
        <span class="font-bold text-white">Renataa • SMK Telkom Malang</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://instagram.com/r4en.ata" target="_blank" class="hover:text-[#FF6B9D] transition-colors flex items-center gap-1.5 font-medium">
          <i data-lucide="instagram" class="w-4 h-4"></i>
          <span>@r4en.ata</span>
        </a>
        <span class="text-slate-600">|</span>
        <p class="text-slate-500">
          Dibuat dengan ❤️ untuk TKJ
        </p>
      </div>
    </div>
  </footer>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Mobile Menu Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });

    // Navbar scroll background change
    window.addEventListener('scroll', () => {
      const navbar = document.getElementById('navbar');
      if (window.scrollY > 30) {
        navbar.classList.add('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-[#FFD6E4]');
      } else {
        navbar.classList.remove('bg-white/90', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-[#FFD6E4]');
      }
    });

    // Project Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-[#FF6B9D]', 'text-white', 'shadow-pink-300/30');
          b.classList.add('bg-white', 'text-slate-600', 'border', 'border-[#FFD6E4]');
        });
        btn.classList.add('bg-[#FF6B9D]', 'text-white', 'shadow-pink-300/30');
        btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-[#FFD6E4]');

        const filterValue = btn.getAttribute('data-filter');

        projectCards.forEach(card => {
          if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // INTERACTIVE TERMINAL SIMULATOR
    const terminalScreen = document.getElementById('terminal-screen');
    const termInput = document.getElementById('term-input');
    const termSubmit = document.getElementById('term-submit');

    function appendTerminalOutput(cmd, outputHtml) {
      const line = document.createElement('div');
      line.className = 'space-y-1';
      line.innerHTML = `
        <div class="flex items-center gap-2 text-slate-400">
          <span class="text-[#FF6B9D] font-bold">➜</span>
          <span class="text-[#FFB8CF] font-bold">~</span>
          <span class="text-white font-bold">${escapeHtml(cmd)}</span>
        </div>
        <div class="text-slate-200 pl-5">${outputHtml}</div>
      `;
      terminalScreen.appendChild(line);
      terminalScreen.scrollTop = terminalScreen.scrollHeight;
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.innerText = text;
      return div.innerHTML;
    }

    function runCommand(rawCmd) {
      const cmd = rawCmd.trim().toLowerCase();
      if (!cmd) return;

      if (cmd === 'clear') {
        terminalScreen.innerHTML = `
          <p class="text-[#FF6B9D] font-bold">Layar dibersihkan.</p>
          <p class="text-slate-400">Ketik <span class="text-[#FF6B9D] font-bold">'help'</span> untuk bantuan.</p>
          <div class="border-b border-[#FF6B9D]/20 my-2"></div>
        `;
        return;
      }

      let response = '';

      switch (cmd) {
        case 'help':
          response = `
            <div class="text-[#FF6B9D] font-bold mb-1">Daftar Perintah yang Tersedia:</div>
            <ul class="space-y-1 text-slate-300">
              <li><strong class="text-[#FF6B9D]">whoami</strong> : Info singkat profil siswa</li>
              <li><strong class="text-[#FF6B9D]">skills</strong> : Daftar teknologi yang dikuasai</li>
              <li><strong class="text-[#FF6B9D]">ping [host]</strong> : Simulasi ping ICMP ke server</li>
              <li><strong class="text-[#FF6B9D]">ip a</strong> : Simulasi menampilkan IP address eth0</li>
              <li><strong class="text-[#FF6B9D]">subnet</strong> : Perhitungan cepat subnet mask /24</li>
              <li><strong class="text-[#FF6B9D]">clear</strong> : Membersihkan layar terminal</li>
            </ul>
          `;
          break;

        case 'whoami':
          response = `
            <p><span class="text-[#FF6B9D] font-bold">Nama:</span> Renataa</p>
            <p><span class="text-[#FF6B9D] font-bold">Sekolah:</span> SMK Telkom Malang</p>
            <p><span class="text-[#FF6B9D] font-bold">Jurusan:</span> Teknik Komputer dan Jaringan (TKJ)</p>
            <p><span class="text-[#FF6B9D] font-bold">Instagram:</span> <a href="https://instagram.com/r4en.ata" target="_blank" class="text-[#FF6B9D] underline font-bold">@r4en.ata</a></p>
            <p><span class="text-[#FF6B9D] font-bold">Motto:</span> "Config first, ping later!"</p>
          `;
          break;

        case 'skills':
          response = `
            <p class="text-[#FFD6E4]">📦 MikroTik RouterOS | Cisco Packet Tracer | Linux Debian</p>
            <p class="text-[#FFD6E4]">🔌 Crimping RJ45 (T568B) | Subnetting IPv4 | Rakit Komputer</p>
            <p class="text-[#FFD6E4]">💻 HTML5 & Tailwind CSS | VirtualBox</p>
          `;
          break;

        case 'ping google.com':
        case 'ping':
          response = `
            <p class="text-slate-400">PING google.com (142.250.190.46) 56(84) bytes of data.</p>
            <p class="text-[#FF6B9D]">64 bytes from 142.250.190.46: icmp_seq=1 ttl=117 time=14.2 ms</p>
            <p class="text-[#FF6B9D]">64 bytes from 142.250.190.46: icmp_seq=2 ttl=117 time=13.8 ms</p>
            <p class="text-[#FF6B9D]">64 bytes from 142.250.190.46: icmp_seq=3 ttl=117 time=14.0 ms</p>
            <p class="text-slate-400 mt-1">--- google.com ping statistics --- 0% packet loss, RTT 14.0ms</p>
          `;
          break;

        case 'ip a':
        case 'ifconfig':
          response = `
            <p><span class="text-[#FF6B9D] font-bold">1: lo:</span> &lt;LOOPBACK,UP&gt; mtu 65536 inet 127.0.0.1/8</p>
            <p><span class="text-[#FF6B9D] font-bold">2: eth0:</span> &lt;BROADCAST,MULTICAST,UP&gt; mtu 1500</p>
            <p class="pl-4 text-[#FFD6E4]">inet 192.168.1.10/24 brd 192.168.1.255 scope global dynamic</p>
            <p class="pl-4 text-slate-500">link/ether b8:27:eb:3d:5a:9c</p>
          `;
          break;

        case 'subnet':
          response = `
            <p class="text-[#FF6B9D] font-bold">Kalkulasi Subnet /24:</p>
            <p class="text-slate-300">• Netmask : 255.255.255.0</p>
            <p class="text-slate-300">• Total IP : 256 alamat</p>
            <p class="text-slate-300">• Usable Host : 254 host (IP .1 s/d .254)</p>
            <p class="text-slate-300">• Network ID : .0 | Broadcast ID: .255</p>
          `;
          break;

        default:
          response = `<p class="text-[#FF6B9D]">Perintah '${escapeHtml(cmd)}' tidak dikenali. Ketik <span class="font-bold underline">'help'</span> untuk daftar perintah.</p>`;
          break;
      }

      appendTerminalOutput(rawCmd, response);
    }

    termSubmit.addEventListener('click', () => {
      const val = termInput.value;
      if (val) {
        runCommand(val);
        termInput.value = '';
      }
    });

    termInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = termInput.value;
        if (val) {
          runCommand(val);
          termInput.value = '';
        }
      }
    });
  </script>
</body>
</html>
